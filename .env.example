# Gemini (콘텐츠 큐레이션, 없으면 원문 그대로 사용)
GEMINI_API_KEY=

# Threads (Meta 공식 Graph API)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Facebook 페이지 (Meta Graph API)
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# Instagram 비즈니스 계정 (Meta Graph API, 피드 게시글은 이미지 URL 필수)
IG_ACCESS_TOKEN=
IG_USER_ID=

# 트렌드 수집 (선택 - 없으면 모의 데이터로 자동 대체)
APIFY_TOKEN_X=
APIFY_TOKEN_THREADS=
RAPIDAPI_KEY=
GITHUB_TOKEN=
