# SNS 캡션/블로그 글은 data/sns_content_queue.json, data/blog_content_queue.json에
# 미리 써둔 내용을 쓰므로 여기엔 AI 키가 필요 없습니다(2026-08-30 변경 — 자동 실행 중
# 유료 API를 호출하지 않기 위함). 큐에 없는 항목은 무료 규칙 기반 템플릿으로 대체됩니다.
# 자동 댓글 답장(services/comment-auto-reply, 별도 Render 배포)은 이 .env가 아니라
# Render 대시보드의 자체 환경변수로 GEMINI_API_KEY를 설정합니다.
#
# 2026-09-17: queueOneTopic(lib/scheduler/queue_topic.js)이 캡션을 만든 뒤
# lib/scheduler/quality_gate.js를 통해 Gemini에게 발행 가능 여부를 한 번 더
# 묻습니다(Claude가 만든 콘텐츠를 다른 AI가 검증 — 자기검증 편향 방지). 통과하면
# 사람 검수 없이 approved:true로 등록됩니다. 비워두면 검증을 건너뛰고 기존처럼
# 항상 사람이 /review에서 승인합니다(안전한 기본값).
GEMINI_API_KEY=

# Threads (Meta 공식 Graph API)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Facebook 페이지 (Meta Graph API)
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# Instagram 비즈니스 계정 (Meta Graph API, 피드 게시글은 이미지 URL 필수)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Reddit (자동 발행 API)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# 트렌드 수집 (선택 - 없으면 모의 데이터로 자동 대체)
APIFY_TOKEN_X=
APIFY_TOKEN_THREADS=
RAPIDAPI_KEY=
GITHUB_TOKEN=
# 워터마크 이미지/합성 영상을 올릴 저장소(owner/repo). 비워두면 이 저장소
# 자신(solusupport-bot/desktop-tutorial)을 씀 — 이 코드를 복제해 새 계정을
# 만들 때는 그 계정 자신의 저장소로 반드시 채울 것(PARALLELIZATION_RISKS.md 참고).
MEDIA_HOST_REPO=
